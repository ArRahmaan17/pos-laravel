# Stage 1: Node - Build frontend assets with npm, yarn, or pnpm
FROM node:22-alpine AS node-builder

WORKDIR /build

# Corepack is needed for yarn and pnpm on modern Node images.
RUN corepack enable

# Copy the app first because Docker's COPY does not support optional lockfiles.
COPY application/ ./

RUN if [ -f yarn.lock ]; then \
      yarn install --frozen-lockfile --prefer-offline; \
    elif [ -f package-lock.json ]; then \
      npm ci --prefer-offline; \
    elif [ -f pnpm-lock.yaml ]; then \
      pnpm install --frozen-lockfile --prefer-offline; \
    else \
      npm install --prefer-offline; \
    fi && \
    npm run build

RUN if [ ! -f public/build/manifest.json ]; then \
      echo "Error: manifest.json not found in public/build/"; \
      ls -R public/build; \
      exit 1; \
    fi


# Stage 2: Composer - Install PHP dependencies
FROM composer:2 AS composer-builder

WORKDIR /app

COPY application/composer.* ./

RUN composer update --no-interaction --no-scripts --optimize-autoloader --ignore-platform-req=*


# Stage 3: FrankenPHP application image
FROM dunglas/frankenphp:php8.4-alpine AS app

LABEL maintainer="pos-laravel"
LABEL description="POS Laravel - FrankenPHP + Caddy"

RUN apk add --no-cache \
    bash \
    curl \
    git \
    zip \
    unzip \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    zlib-dev \
    freetype-dev \
    icu-dev \
    oniguruma-dev \
    libzip-dev

RUN install-php-extensions \
    pdo \
    pdo_mysql \
    redis \
    gd \
    intl \
    zip \
    bcmath \
    pcntl \
    opcache \
    mbstring \
    exif \
    fileinfo
# carefull with opcache, it can cause issues during development if not configured properly. Make sure to adjust settings for development vs production environments.
COPY build/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html

COPY --chown=www-data:www-data application/ ./

RUN rm -f bootstrap/cache/*.php

COPY --from=composer-builder --chown=www-data:www-data /app/vendor ./vendor
COPY --from=node-builder --chown=www-data:www-data /build/public/build ./public/build/

COPY --chown=www-data:www-data application/example.CaddyFile /etc/frankenphp/Caddyfile

RUN mkdir -p \
        storage/logs/frankendata \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/app/public \
        bootstrap/cache && \
    chown -R www-data:www-data storage bootstrap/cache && \
    chmod -R 775 storage bootstrap/cache

COPY --chown=root:root build/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["frankenphp"]
