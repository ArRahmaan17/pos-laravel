:{$FRANKENPHP_PORT:8000} {
	log {
		level {$CADDY_LOG_LEVEL:INFO}
	}

	root * /var/www/html/public
	encode zstd br gzip

	@health path /healthz
	respond @health "OK" 200

	@blockPHP path_regexp blockphp .*\.php$
	respond @blockPHP "Forbidden" 403

	php_server {
		try_files {path} index.php
	}

	header /build/* Cache-Control "no-store"
}
